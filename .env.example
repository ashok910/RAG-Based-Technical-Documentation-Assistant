# ============================================================
# RAG Technical Documentation Assistant - Environment Config
# ============================================================
# Copy this file to .env and fill in your API keys

# ----------------------------
# LLM Provider (choose ONE)
# ----------------------------
# Option A: Groq (recommended - generous free tier, very fast)
GROQ_API_KEY=your_groq_api_key_here

# Option B: OpenAI
# OPENAI_API_KEY=your_openai_api_key_here

# Option C: Google Gemini
# GOOGLE_API_KEY=your_google_api_key_here

# Option D: Anthropic
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ----------------------------
# Active LLM Provider
# ----------------------------
LLM_PROVIDER=groq          # Options: groq, openai, google, anthropic
LLM_MODEL=llama3-8b-8192   # groq: llama3-8b-8192 | openai: gpt-4o-mini | google: gemini-1.5-flash | anthropic: claude-3-haiku-20240307

# ----------------------------
# Embedding Model
# ----------------------------
EMBEDDING_MODEL=all-MiniLM-L6-v2   # Free, local sentence-transformer model

# ----------------------------
# Vector Store
# ----------------------------
VECTOR_STORE_TYPE=chroma            # Options: chroma, faiss
CHROMA_PERSIST_DIR=./data/chroma_db
FAISS_INDEX_PATH=./data/faiss_index

# ----------------------------
# Retrieval Settings
# ----------------------------
TOP_K_RETRIEVAL=5
CHUNK_SIZE=800
CHUNK_OVERLAP=100
MAX_RETRIES=2

# ----------------------------
# Web Search Fallback (Bonus)
# ----------------------------
ENABLE_WEB_SEARCH=false
TAVILY_API_KEY=your_tavily_api_key_here   # Free at tavily.com

# ----------------------------
# App Settings
# ----------------------------
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:8080","http://127.0.0.1:8000"]
